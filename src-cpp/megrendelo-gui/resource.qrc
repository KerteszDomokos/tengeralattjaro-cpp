<RCC>
    <qresource prefix="/languages">
        <file>megrendelo-gui_en_EN.ts</file>
        <file>megrendelo-gui_en_EN.qm</file>
    </qresource>
    <qresource prefix="/resources">
        <file alias="darkmode">resources/dark-style.qss</file>
        <file alias="lightmode">resources/lightmode.qss</file>
        <file alias="pauseico">resources/pause.ico</file>
        <file>resources/play.ico</file>
        <file alias="ico">resources/program-icon.ico</file>
    </qresource>
    <qresource prefix="/">
        <file alias="3d">3d.qml</file>
    </qresource>
</RCC>
