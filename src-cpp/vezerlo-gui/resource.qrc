<RCC>
    <qresource prefix="/qml-files">
        <file alias="3d">qml-files/3dview.qml</file>
        <file alias="compass">qml-files/compass.qml</file>
        <file alias="horizon">qml-files/horizon.qml</file>
        <file alias="joy">qml-files/joy.qml</file>
        <file alias="melyseg">qml-files/magassag.qml</file>
        <file alias="map">qml-files/map.qml</file>
        <file alias="radar">qml-files/radar.qml</file>
        <file alias="robotkar">qml-files/robotkar.qml</file>
    </qresource>
    <qresource prefix="/programs">
        <file alias="joypy">python-files/joystick.py</file>
        <file alias="keppy">python-files/kep.py</file>
        <file alias="darkmode">resources/dark-style.qss</file>
        <file alias="lightmode">resources/lightmode.qss</file>
    </qresource>
    <qresource prefix="/horizon">
        <file>resources/components/rollPitchIndicator/artGroundSky.svg</file>
        <file>resources/components/rollPitchIndicator/background.png</file>
        <file>resources/components/rollPitchIndicator/background_old.png</file>
        <file>resources/components/rollPitchIndicator/compass.svg</file>
        <file>resources/components/rollPitchIndicator/compassIndicator.svg</file>
        <file>resources/components/rollPitchIndicator/crossHair.svg</file>
        <file>resources/components/rollPitchIndicator/needle.png</file>
        <file>resources/components/rollPitchIndicator/needle_shadow.png</file>
        <file>resources/components/rollPitchIndicator/overlay.png</file>
        <file>resources/components/rollPitchIndicator/pitchGraticule.png</file>
        <file>resources/components/rollPitchIndicator/quit.png</file>
        <file>resources/components/rollPitchIndicator/rollGraticule.svg</file>
        <file>resources/components/rollPitchIndicator/rollPointer.svg</file>
        <file>resources/compass.svg</file>
        <file>resources/compass-nyil.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="play">resources/play.ico</file>
        <file alias="pause">resources/pause.ico</file>
    </qresource>
    <qresource prefix="/dok">
        <file>documentation/dokumentacio.md</file>
        <file>documentation/dokumentacio.html</file>
    </qresource>
</RCC>
